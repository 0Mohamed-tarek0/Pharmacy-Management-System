@model PharmacyBL.DTOs.Medicines.UpdateMedicineDto

@using PharmacyBL.DTOs.Categories
@using PharmacyDAL.Enums

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Edit Medicine</h3>
    </div>

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Type"></label>
                        <select asp-for="Type" class="form-control" asp-items="Html.GetEnumSelectList<MedicineType>()">
                            <option value="">Select Type</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MinimumStock"></label>
                        <input asp-for="MinimumStock" class="form-control" />
                        <small class="form-text text-muted">Reorder threshold, in base units, across all batches.</small>
                        <span asp-validation-for="MinimumStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Barcode"></label>
                        <input asp-for="Barcode" class="form-control" />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Category</label>
                        <select asp-for="CategoryId"
                                class="form-control"
                                asp-items="@(new SelectList((IEnumerable<CategoryDto>)ViewBag.Categories, "Id", "Name"))">
                            <option value="">Select Category</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="BaseUnitName"></label>
                        <select asp-for="BaseUnitName" class="form-control">
                            <option value="">Select Unit</option>
                            <option value="Tablet">Tablet</option>
                            <option value="Capsule">Capsule</option>
                            <option value="Strip">Strip</option>
                            <option value="Ampoule">Ampoule</option>
                            <option value="Vial">Vial</option>
                            <option value="Tube">Tube</option>
                            <option value="Bottle">Bottle</option>
                            <option value="Box">Box</option>
                            <option value="Sachet">Sachet</option>
                            <option value="Jar">Jar</option>
                            <option value="Piece">Piece</option>
                            <option value="Pack">Pack</option>
                            <option value="Roll">Roll</option>
                            <option value="Syringe">Syringe</option>
                            <option value="Bag">Bag</option>
                        </select>
                        <small class="form-text text-muted">The smallest unit this medicine is sold in.</small>
                        <span asp-validation-for="BaseUnitName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="alert alert-info">
                To manage batches (price/expiry/quantity) or units (Box, Strip...), go to
                <a asp-action="Details" asp-route-id="@Model.Id">Medicine Details</a>.
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
