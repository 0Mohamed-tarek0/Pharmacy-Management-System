@model IEnumerable<PharmacyBL.DTOs.Medicines.MedicineDto>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Medicines</h3>

        <div class="card-tools">
            <a asp-action="ExpiryReport" class="btn btn-outline-secondary">Batches by Expiry</a>
            <a asp-action="Create" class="btn btn-primary">Add Medicine</a>
        </div>
    </div>

    <div class="card-body">
        <div class="form-group" style="max-width: 350px;">
            <input type="text" id="medicineFilter" class="form-control" placeholder="Search by name, category or barcode..." autocomplete="off" />
        </div>

        <table class="table table-bordered table-hover" id="medicinesTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Selling Price</th>
                    <th>Total Quantity</th>
                    <th>Barcode</th>
                    <th width="220">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var medicine in Model)
                {
                    <tr class="@(medicine.IsLowStock ? "table-danger" : "")"
                        data-search="@($"{medicine.Name} {medicine.CategoryName} {medicine.Barcode}".ToLowerInvariant())">
                        <td>@medicine.Name</td>
                        <td>@medicine.Type</td>
                        <td>@medicine.CategoryName</td>
                        <td>@(medicine.SellingPrice?.ToString("0.00") ?? "-")</td>
                        <td>
                            @medicine.TotalQuantity
                            @if (medicine.IsLowStock)
                            {
                                <span class="badge badge-danger">Low stock</span>
                            }
                        </td>
                        <td>@medicine.Barcode</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@medicine.Id" class="btn btn-info btn-sm">Details</a>

                            <a asp-action="Edit" asp-route-id="@medicine.Id" class="btn btn-warning btn-sm">Edit</a>

                            @* <a asp-action="Delete" asp-route-id="@medicine.Id" class="btn btn-danger btn-sm">Delete</a> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p id="medicineFilterEmpty" class="text-muted text-center" style="display:none;">No medicines match your search.</p>
    </div>

</div>

<script>
    const medicineFilterInput = document.getElementById('medicineFilter');
    const medicineRows = document.querySelectorAll('#medicinesTable tbody tr[data-search]');
    const medicineFilterEmpty = document.getElementById('medicineFilterEmpty');

    medicineFilterInput.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        let visibleCount = 0;

        medicineRows.forEach(row => {
            const matches = !query || row.dataset.search.includes(query);
            row.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
        });

        medicineFilterEmpty.style.display = visibleCount === 0 ? '' : 'none';
    });
</script>
