@model PharmacyBL.DTOs.Medicines.MedicineDetailsDto

@{
    ViewData["Title"] = $"{Model.Name} - Details";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@Model.Name</h3>
        <div class="card-tools">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Edit</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
    </div>

    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-3">
                <strong>Category</strong>
                <div>@Model.CategoryName</div>
            </div>
            <div class="col-md-3">
                <strong>Type</strong>
                <div>@Model.Type</div>
            </div>
            <div class="col-md-3">
                <strong>Total Quantity</strong>
                <div>
                    @Model.TotalQuantity
                    @if (Model.TotalQuantity <= Model.MinimumStock)
                    {
                        <span class="badge badge-danger">Low stock</span>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <strong>Barcode</strong>
                <div>@Model.Barcode</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }

        <h5 class="mt-4">Available Batches</h5>
        <p class="text-muted">
            Sold First-Expire-First-Out (FEFO): the batch expiring soonest at the top is deducted from first.
        </p>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Batch No</th>
                    <th>Expiry</th>
                    <th>Purchase Price</th>
                    <th>Selling Price</th>
                    <th>Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Batches.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No batches received yet.</td></tr>
                }
                @foreach (var batch in Model.Batches)
                {
                    <tr class="@(batch.IsExpired ? "table-danger" : "")">
                        <td>@batch.BatchNumber</td>
                        <td>@batch.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>@batch.PurchasePrice.ToString("0.00")</td>
                        <td>@batch.SellingPrice.ToString("0.00")</td>
                        <td>@batch.Quantity</td>
                        <td>@(batch.IsExpired ? "Expired" : "OK")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h5 class="mt-4">Units</h5>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Equals (in base units)</th>
                    <th>Base Unit?</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>@unit.UnitName</td>
                        <td>@unit.ConversionFactor</td>
                        <td>@(unit.IsBaseUnit ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
