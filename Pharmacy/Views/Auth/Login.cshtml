@model Pharmacy.ViewModels.Authentication.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">

    <div class="auth-brand-panel">

        <div class="brand-logo">
            <i class="fas fa-prescription-bottle-alt"></i>
        </div>

        <h1>PharmaCare</h1>
        <p>The all-in-one platform to manage inventory, suppliers, staff and sales for your pharmacy — simply and securely.</p>

        <ul class="auth-feature-list">
            <li><i class="fas fa-capsules"></i> Track medicines &amp; stock levels in real time</li>
            <li><i class="fas fa-truck"></i> Manage suppliers &amp; purchase orders</li>
            <li><i class="fas fa-user-shield"></i> Role-based access for your team</li>
            <li><i class="fas fa-chart-line"></i> Insightful sales &amp; reporting</li>
        </ul>

    </div>

    <div class="auth-form-panel">

        <div class="auth-form-box">

            <div class="auth-icon-circle">
                <i class="fas fa-lock"></i>
            </div>

            <h2>Welcome back</h2>
            <p class="auth-subtitle">Sign in to access your pharmacy dashboard.</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-circle-exclamation"></i>
                    <span>@ViewData.ModelState[""]!.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>
            }

            <form asp-action="Login" method="post" novalidate>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email"></label>
                    <div class="input-icon-group">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="you@pharmacare.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"></label>
                    <div class="input-icon-group">
                        <i class="fas fa-key"></i>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-right-to-bracket me-1"></i> Sign In
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
