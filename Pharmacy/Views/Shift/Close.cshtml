@model Pharmacy.ViewModels.Shifts.CloseShiftViewModel
@{ ViewData["Title"] = "Close Shift"; }
<div class="page-header"><div class="page-title"><div class="page-icon"><i class="fas fa-lock"></i></div><div><h1>Close & Reconcile</h1><p class="page-subtitle">Count the drawer and enter the actual cash.</p></div></div><a asp-action="Index" class="btn btn-outline-primary">Cancel</a></div>
<div class="row"><div class="col-lg-7"><div class="card card-outline card-primary"><div class="card-body"><p class="text-muted mb-1">Opening cash</p><h4>@Model.Shift.OpeningCash.ToString("N2")</h4><p class="text-muted mt-3 mb-1">The exact sales, returns, and expected cash are calculated when you submit this close.</p></div><form asp-action="Close" method="post"><input asp-for="Id" type="hidden" /><div class="card-body border-top"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><label asp-for="ActualCash"></label><input asp-for="ActualCash" class="form-control" type="number" step="0.01" min="0" autofocus /><span asp-validation-for="ActualCash" class="text-danger small"></span></div><div class="card-footer"><button class="btn btn-danger" type="submit"><i class="fas fa-lock me-1"></i> Close Shift</button></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
