@model PharmacyBL.DTOs.Shifts.ShiftDto
@{ ViewData["Title"] = "Shift Details"; }
<div class="page-header"><div class="page-title"><div class="page-icon"><i class="fas fa-receipt"></i></div><div><h1>Shift Reconciliation</h1><p class="page-subtitle">Opened @Model.OpenedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") · Closed @Model.ClosedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div></div><a asp-action="Index" class="btn btn-outline-primary">Back to Shifts</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div class="row"><div class="col-lg-8"><div class="card"><div class="card-body"><table class="table mb-0"><tbody><tr><th>Opening cash</th><td class="text-end">@Model.OpeningCash.ToString("N2")</td></tr><tr><th>Sales</th><td class="text-end text-success">+ @Model.SalesTotal?.ToString("N2")</td></tr><tr><th>Processed returns</th><td class="text-end text-danger">- @Model.ReturnsTotal?.ToString("N2")</td></tr><tr class="fw-bold"><th>Expected cash</th><td class="text-end">@Model.ExpectedCash?.ToString("N2")</td></tr><tr><th>Actual cash</th><td class="text-end">@Model.ActualCash?.ToString("N2")</td></tr><tr class="fw-bold"><th>Over / Short</th><td class="text-end @(Model.CashDifference >= 0 ? "text-success" : "text-danger")">@Model.CashDifference?.ToString("+0.00;-0.00;0.00")</td></tr></tbody></table></div></div></div></div>
