@model Pharmacy.ViewModels.Shifts.OpenShiftViewModel
@{ ViewData["Title"] = "Open Shift"; }
<div class="page-header"><div class="page-title"><div class="page-icon"><i class="fas fa-door-open"></i></div><div><h1>Open Shift</h1><p class="page-subtitle">Enter the cash currently in the drawer.</p></div></div><a asp-action="Index" class="btn btn-outline-primary">Back to Shifts</a></div>
<div class="row"><div class="col-lg-6"><div class="card card-outline card-primary"><form asp-action="Open" method="post"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><label asp-for="OpeningCash"></label><input asp-for="OpeningCash" class="form-control" type="number" step="0.01" min="0" autofocus /><span asp-validation-for="OpeningCash" class="text-danger small"></span></div><div class="card-footer"><button class="btn btn-primary" type="submit"><i class="fas fa-check me-1"></i> Open Shift</button></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
