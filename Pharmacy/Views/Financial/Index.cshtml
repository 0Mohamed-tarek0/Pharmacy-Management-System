						<select name="period" id="period" class="form-control">
							<option value="today" selected="@(Model.Period == "today")">
								Today
							</option>
							<option value="yesterday" selected="@(Model.Period == "yesterday")">
								Yesterday
							</option>
							<option value="three-days-ago" selected="@(Model.Period == "three-days-ago")">
								Three days ago
							</option>
							<option value="this-week" selected="@(Model.Period == "this-week")">
								This week
							</option>
							<option value="last-week" selected="@(Model.Period == "last-week")">
								Last week
							</option>
							<option value="last-2-weeks" selected="@(Model.Period == "last-2-weeks")">
								Last 14 days
							</option>
							<option value="this-month" selected="@(Model.Period == "this-month")">
								This month
							</option>
							<option value="last-month" selected="@(Model.Period == "last-month")">
								Last month
							</option>
							<option value="this-year" selected="@(Model.Period == "this-year")">
								This year
							</option>
							<option value="last-year" selected="@(Model.Period == "last-year")">
								Last year
							</option>
							<option value="all" selected="@(Model.Period == "all")">
								All recorded time
							</option>
							<option value="custom" selected="@(Model.Period == "custom")">
								Custom range
							</option>
						</select>
				</div>
					<div class="col-lg-3 mb-2 custom-date">
						<label class="form-label fw-semibold">
							From
						</label>
							<input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
					</div>
					<div class="col-lg-3 mb-2 custom-date">
						<label class="form-label fw-semibold">
							To
						</label>
						<input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
					</div>
					<div class="col-lg-2 mb-2">
						<button class="btn btn-primary w-100" type="submit">
							<i class="fas fa-filter me-1">

							</i> 
							Apply
						</button>
					</div>
			/div>
		</div>
	</form>
</div>

<div class="row">
	<div class="col-lg-3 col-md-6 mb-4">
		<div class="metric-card metric-success">
			<div>
				<span>Net Sales</span><h2>@s.NetSales.ToString("N2")</h2><small>Sales less customer returns</small>
