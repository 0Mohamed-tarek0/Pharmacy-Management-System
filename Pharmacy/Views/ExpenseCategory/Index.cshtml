@model IEnumerable<PharmacyBL.DTOs.ExpenseCategories.ExpenseCategoryDto>

@{
    ViewData["Title"] = "Expense Categories";
}

<div class="page-header">
    <div class="page-title">
        <div class="page-icon">
            <i class="fas fa-folder-open"></i>
        </div>
        <div>
            <h1>Expense Categories</h1>
            <p class="page-subtitle">Manage categories used to classify pharmacy expenses.</p>
        </div>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add Category
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list text-primary-teal"></i>
            All Expense Categories
        </h3>
        <span class="badge badge-soft-primary">@Model.Count() total</span>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h5>No expense categories yet</h5>
                <p>Add categories like Rent, Electricity, or Salaries to organize expenses.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Add Category
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">
                                            <i class="fas fa-folder" style="font-size:14px;"></i>
                                        </div>
                                        <span class="fw-semibold">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm btn-icon"
                                       title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-danger btn-sm btn-icon"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this expense category?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Expense" asp-action="Index" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-1"></i> Back to Expenses
    </a>
</div>
