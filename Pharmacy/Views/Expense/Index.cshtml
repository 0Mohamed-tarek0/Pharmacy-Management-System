@model IEnumerable<PharmacyBL.DTOs.Expenses.ExpenseDto>

@{
    ViewData["Title"] = "Expenses";
    var totalAmount = Model.Sum(e => e.Amount);
}

<div class="page-header">
    <div class="page-title">
        <div class="page-icon">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div>
            <h1>Expenses</h1>
            <p class="page-subtitle">Track and manage pharmacy operating expenses.</p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="ExpenseCategory" asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-folder-open me-1"></i> Categories
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add Expense
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list text-primary-teal"></i>
            All Expenses
        </h3>
        <span class="badge badge-soft-primary">@Model.Count() total · @totalAmount.ToString("N2")</span>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <h5>No expenses recorded yet</h5>
                <p>Start tracking rent, utilities, salaries, and other operating costs.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Add Expense
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th>Recorded By</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-semibold">@item.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <small class="text-muted">@item.Notes</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-soft-primary">@item.ExpenseCategoryName</span>
                                </td>
                                <td>@item.ExpenseDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end fw-semibold text-danger">@item.Amount.ToString("N2")</td>
                                <td class="text-muted">@item.RecordedBy</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm btn-icon"
                                       title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-danger btn-sm btn-icon"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this expense?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
