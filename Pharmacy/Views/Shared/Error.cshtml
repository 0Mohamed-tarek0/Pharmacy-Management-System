@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">

    <div class="status-page" style="max-width:520px;">

        <div class="status-icon" style="background:#FEF3C7;color:var(--warning-color);">
            <i class="fas fa-triangle-exclamation"></i>
        </div>

        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request. Please try again, and if the problem persists, contact support.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mb-4">
                <span class="badge badge-soft-primary">Request ID: @Model.RequestId</span>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-house me-1"></i> Back to Home
        </a>

    </div>

</div>
