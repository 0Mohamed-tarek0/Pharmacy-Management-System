@model PharmacyBL.DTOs.Orders.OrderDetailsDto

@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Order @Model.OrderNumber</h3>
        <div class="card-tools">
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-circle-check"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-circle-exclamation"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-3">
                <strong>Supplier</strong>
                <div>@Model.SupplierName</div>
            </div>
            <div class="col-md-3">
                <strong>Date</strong>
                <div>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
            <div class="col-md-3">
                <strong>Status</strong>
                <div>@Model.Status</div>
            </div>
            <div class="col-md-3">
                <strong>Received By</strong>
                <div>@(string.IsNullOrWhiteSpace(Model.CreatedByUserName) ? "-" : Model.CreatedByUserName)</div>
            </div>
        </div>

        <h5>Items</h5>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Batch No</th>
                    <th>Expiry</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                    <th>Purchase Price</th>
                    <th>Selling Price</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th>Returned</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">No items on this order.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.MedicineName</td>
                        <td>@item.BatchNumber</td>
                        <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitName</td>
                        <td>@item.PurchasePrice.ToString("0.00")</td>
                        <td>@item.SellingPrice.ToString("0.00")</td>
                        <td>@item.Discount.ToString("0.00")%</td>
                        <td>@item.Total.ToString("0.00")</td>
                        <td>
                            @item.ReturnedQuantity
                            @if (item.ReturnedQuantity > 0)
                            {
                                <span class="badge bg-warning text-dark">Returned</span>
                            }
                        </td>
                        <td>
                            @if (item.ReturnableQuantity > 0)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#returnModal-@item.Id">
                                    <i class="fas fa-rotate-left me-1"></i> Return
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">Fully returned</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="8" class="text-right">Grand Total</th>
                    <th colspan="3">@Model.TotalAmount.ToString("0.00")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@* Modals are rendered outside the table on purpose: Bootstrap modals nested inside
   a <table> can get clipped or fail to display because of the table's own layout/
   overflow behavior. Keeping them as siblings of the table avoids that. *@
@foreach (var item in Model.Items)
{
    if (item.ReturnableQuantity > 0)
    {
        <div class="modal fade" id="returnModal-@item.Id"
             tabindex="-1"
             aria-labelledby="returnModalLabel-@item.Id"
             aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="ReturnItem" method="post">
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <input type="hidden" name="OrderItemId" value="@item.Id" />

                        <div class="modal-header">
                            <h5 class="modal-title" id="returnModalLabel-@item.Id">Return @item.MedicineName to supplier</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">
                                Batch <strong>@item.BatchNumber</strong> &middot;
                                Purchased @item.Quantity @(item.UnitName)(s), already returned @item.ReturnedQuantity.
                            </p>
                            <div class="form-group mb-3">
                                <label for="returnQuantity-@item.Id">Quantity to return (@item.UnitName)</label>
                                <input id="returnQuantity-@item.Id" type="number" name="Quantity" class="form-control"
                                       min="1" max="@item.ReturnableQuantity" value="1" required />
                                <small class="text-muted">Up to @item.ReturnableQuantity @(item.UnitName)(s) can still be returned.</small>
                            </div>
                            <div class="form-group">
                                <label for="returnReason-@item.Id">Reason (optional)</label>
                                <textarea id="returnReason-@item.Id" name="Reason" class="form-control" rows="2" placeholder="e.g. Damaged packaging, wrong batch..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Confirm Return</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all modals
            document.querySelectorAll('.modal').forEach(function(modalEl) {
                try {
                    if (!bootstrap.Modal.getInstance(modalEl)) {
                        new bootstrap.Modal(modalEl);
                    }
                } catch (e) {
                    console.warn('Modal initialization error:', e);
                }
            });
        });
    </script>
}