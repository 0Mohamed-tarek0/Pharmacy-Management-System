@model PharmacyBL.DTOs.Orders.CreateOrderDto

@using PharmacyBL.DTOs.Suppliers
@using PharmacyBL.DTOs.Medicines

@{
    ViewData["Title"] = "New Purchase Order";
    var suppliers = (IEnumerable<SupplierDto>)ViewBag.Suppliers;
    var medicines = (IEnumerable<MedicineDto>)ViewBag.Medicines;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">New Purchase Order</h3>
    </div>

    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group col-md-4 px-0">
            <label>Supplier</label>
            <select id="supplierId" class="form-control">
                <option value="">Select Supplier</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.CompanyName</option>
                }
            </select>
        </div>

        <hr />

        <h5>Add Item</h5>
        <div class="row">
            <div class="col-md-3 form-group">
                <label>Medicine</label>
                <select id="medicineId" class="form-control">
                    <option value="">Select Medicine</option>
                    @foreach (var m in medicines)
                    {
                        <option value="@m.Id" data-type="@m.Type" data-barcode="@m.Barcode" data-category="@m.CategoryName">@m.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 form-group">
                <label>Type</label>
                <input id="itemType" class="form-control" readonly />
            </div>
            <div class="col-md-2 form-group">
                <label>Category</label>
                <input id="itemCategory" class="form-control" readonly />
            </div>
            <div class="col-md-2 form-group">
                <label>Barcode</label>
                <input id="itemBarcode" class="form-control" readonly />
            </div>
            <div class="col-md-3 form-group">
             <label>Unit</label>
                <select id="itemUnit" class="form-control">
                    <option value="">Select Unit</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-2 form-group">
                <label>Quantity</label>
                <input id="itemQuantity" type="number" min="1" class="form-control" />
            </div>
            <div class="col-md-2 form-group">
                <label>Purchase Price</label>
                <input id="itemPurchasePrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-2 form-group">
                <label>Selling Price</label>
                <input id="itemSellingPrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-2 form-group">
                <label>Discount</label>
                <input id="itemDiscount" type="number" step="0.01" min="0" value="0" class="form-control" />
            </div>
            <div class="col-md-2 form-group">
                <label>Batch Number</label>
                <input id="itemBatchNumber" class="form-control" />
            </div>
            <div class="col-md-2 form-group">
                <label>Expiry Date</label>
                <input id="itemExpiryDate" type="date" class="form-control" />
            </div>
        </div>

        <button type="button" id="addItemBtn" class="btn btn-primary mb-3">Add</button>

        <table class="table table-bordered table-sm" id="itemsTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Quantity</th>
                    <th>Selling Price</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div class="row mt-3">
            <div class="col-md-4 offset-md-8">
                <table class="table table-bordered">
                    <tr>
                        <th>Total Items</th>
                        <td id="totalItems">0</td>
                    </tr>
                    <tr>
                        <th>Total Quantity</th>
                        <td id="totalQuantity">0</td>
                    </tr>
                    <tr>
                        <th>Grand Total</th>
                        <td id="grandTotal">0.00</td>
                    </tr>
                </table>
            </div>
        </div>
        <form asp-action="Create" method="post" id="orderForm">
            <input type="hidden" asp-for="SupplierId" id="supplierIdHidden" />
            <div id="hiddenItemsContainer"></div>

            <button type="submit" class="btn btn-success" id="submitOrderBtn" disabled>Submit Order</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const items = [];

        const medicineSelect = document.getElementById('medicineId');
                medicineSelect.addEventListener('change', async function () {

            const opt = this.options[this.selectedIndex];

            document.getElementById('itemType').value = opt.dataset.type || '';
            document.getElementById('itemCategory').value = opt.dataset.category || '';
            document.getElementById('itemBarcode').value = opt.dataset.barcode || '';

            const medicineId = this.value;

            const unitSelect = document.getElementById('itemUnit');

            unitSelect.innerHTML =
                '<option value="">Loading...</option>';

            if (!medicineId)
                return;

            const response =
                await fetch(`/Order/GetMedicineUnits?medicineId=${medicineId}`);

            const units = await response.json();

            unitSelect.innerHTML = '';

            units.forEach(u => {

                unitSelect.innerHTML +=
                    `<option value="${u.unitName}">
                        ${u.unitName}
                    </option>`;

            });

        });

        document.getElementById('addItemBtn').addEventListener('click', function () {
            const medicineId = medicineSelect.value;
            const medicineName = medicineSelect.options[medicineSelect.selectedIndex]?.text;
            const quantity = parseInt(document.getElementById('itemQuantity').value || '0', 10);
            const unitName = document.getElementById('itemUnit').value || '';
            const purchasePrice = parseFloat(document.getElementById('itemPurchasePrice').value || '0');
            const sellingPrice = parseFloat(document.getElementById('itemSellingPrice').value || '0');
            const discount = parseFloat(document.getElementById('itemDiscount').value || '0');
            const batchNumber = document.getElementById('itemBatchNumber').value;
            const expiryDate = document.getElementById('itemExpiryDate').value;

            if (!medicineId || !quantity || !batchNumber || !expiryDate) {
                alert('Please fill in Medicine, Quantity, Batch Number and Expiry Date.');
                return;
            }

            const total = (quantity * purchasePrice) - discount;
                    const alreadyExists = items.some(x =>
            x.medicineId == medicineId &&
            x.batchNumber === batchNumber
        );

        if (alreadyExists) {
            alert("This medicine with the same batch already exists in the order.");
            return;
        }
                const exists = items.some(x =>
            x.medicineId == medicineId &&
            x.batchNumber.toLowerCase() === batchNumber.toLowerCase());

        if (exists) {
            alert("This medicine with the same batch already exists in the order.");
            return;
        }

                if (purchasePrice <= 0) {
            alert("Purchase Price must be greater than zero.");
            return;
        }

        if (sellingPrice <= 0) {
            alert("Selling Price must be greater than zero.");
            return;
        }

        if (sellingPrice < purchasePrice) {
            alert("Selling Price cannot be less than Purchase Price.");
            return;
        }

                if (quantity <= 0) {
            alert("Quantity must be greater than zero.");
            return;
        }

                const today = new Date();
        today.setHours(0,0,0,0);

        const expiry = new Date(expiryDate);

        if (expiry <= today) {
            alert("Expiry Date must be in the future.");
            return;
        }
            items.push({
                medicineId, medicineName, quantity, unitName,
                purchasePrice, sellingPrice, discount, total,
                batchNumber, expiryDate
            });

            renderTable();
            renderHiddenInputs();
            updateSummary();

            // reset the add-item inputs for the next row
            document.getElementById('itemQuantity').value = '';
            document.getElementById('itemUnit').value = '';
            document.getElementById('itemPurchasePrice').value = '';
            document.getElementById('itemSellingPrice').value = '';
            document.getElementById('itemDiscount').value = '0';
            document.getElementById('itemBatchNumber').value = '';
            document.getElementById('itemExpiryDate').value = '';
        });

        function renderTable() {
            const tbody = document.querySelector('#itemsTable tbody');
            tbody.innerHTML = '';
            items.forEach((it, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${it.medicineName}</td>
                    <td>${it.quantity} ${it.unitName}</td>
                    <td>${it.sellingPrice.toFixed(2)}</td>
                    <td>${it.discount.toFixed(2)}</td>
                    <td>${it.total.toFixed(2)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeItem(${idx})">Remove</button></td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('submitOrderBtn').disabled = items.length === 0;
        }

        function removeItem(idx) {
            items.splice(idx, 1);
            renderTable();
            renderHiddenInputs();
        }

        function renderHiddenInputs() {
            const container = document.getElementById('hiddenItemsContainer');
            container.innerHTML = '';
            items.forEach((it, idx) => {
                container.insertAdjacentHTML('beforeend', `
                    <input type="hidden" name="Items[${idx}].MedicineId" value="${it.medicineId}" />
                    <input type="hidden" name="Items[${idx}].Quantity" value="${it.quantity}" />
                    <input type="hidden" name="Items[${idx}].UnitName" value="${it.unitName}" />
                    <input type="hidden" name="Items[${idx}].purchasePrice" value="${it.purchasePrice}" />
                    <input type="hidden" name="Items[${idx}].SellingPrice" value="${it.sellingPrice}" />
                    <input type="hidden" name="Items[${idx}].Discount" value="${it.discount}" />
                    <input type="hidden" name="Items[${idx}].BatchNumber" value="${it.batchNumber}" />
                    <input type="hidden" name="Items[${idx}].ExpiryDate" value="${it.expiryDate}" />
                `);
            });
        }

                function updateSummary() {

            document.getElementById("totalItems").innerText = items.length;

            let qty = 0;
            let total = 0;

            items.forEach(i => {
                qty += i.quantity;
                total += i.total;
            });

            document.getElementById("totalQuantity").innerText = qty;
            document.getElementById("grandTotal").innerText = total.toFixed(2);
        }

        document.getElementById('supplierId').addEventListener('change', function () {
            document.getElementById('supplierIdHidden').value = this.value;
        });

        document.getElementById('orderForm').addEventListener('submit', function (e) {
            if (!document.getElementById('supplierIdHidden').value) {
                e.preventDefault();
                alert('Please select a supplier.');
            }
        });
    </script>
}
