@model PharmacyBL.DTOs.Sales.SaleDetailsDto

@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
}

<div class="page-header d-print-none">
    <div class="page-title">
        <div class="page-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div>
            <h1>Invoice details</h1>
            <p class="page-subtitle">Invoice receipt #@Model.InvoiceNumber</p>
        </div>
    </div>

    <div>
        <button onclick="window.print();" class="btn btn-success me-2">
            <i class="fas fa-print me-1"></i> Print Receipt
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Sales
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-print-none">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-print-none">
        <i class="fas fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="card card-outline card-teal invoice-container">
    <div class="card-body">

        <!-- Receipt Header -->
        <div class="row mb-4">
            <div class="col-sm-6">
                <h4 class="text-primary-teal font-weight-bold mb-1">
                    <i class="fas fa-prescription-bottle-alt me-2"></i> PharmaCare Pharmacy
                </h4>
                <p class="text-muted mb-0">Quality Healthcare & Medicine</p>
                <small class="text-muted">123 Health Avenue, Cairo, Egypt</small>
            </div>
            <div class="col-sm-6 text-sm-right mt-3 mt-sm-0">
                <h5 class="text-dark font-weight-bold mb-0">SALES INVOICE</h5>
                <span class="badge bg-success">@Model.Status</span>
                <div class="mt-2 text-muted">
                    <strong>Invoice #:</strong> @Model.InvoiceNumber <br />
                    <strong>Date:</strong> @Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>
        </div>

        <hr />

        <!-- Cashier Details -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted text-uppercase font-weight-bold mb-2">Cashier / Pharmacist</h6>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex justify-content-center align-items-center bg-teal-light text-primary-teal font-weight-bold" style="width: 32px; height: 32px;">
                        @Model.CashierName.Substring(0, 1).ToUpper()
                    </div>
                    <span class="font-weight-semibold text-dark">@Model.CashierName</span>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-striped table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 5%">#</th>
                        <th>Medicine Description</th>
                        <th class="text-center" style="width: 12%">Quantity</th>
                        <th class="text-right" style="width: 13%">Unit Price</th>
                        <th class="text-right" style="width: 13%">Discount</th>
                        <th class="text-right" style="width: 13%">Total</th>
                        <th class="text-center d-print-none" style="width: 10%">Returned</th>
                        <th class="text-center d-print-none" style="width: 14%"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        decimal subtotal = 0;
                        decimal totalDiscount = 0;
                    }
                    @foreach (var item in Model.Items)
                    {
                        var lineRevenue = (item.Quantity * item.UnitPrice);
                        subtotal += lineRevenue;
                        totalDiscount += item.Discount;
                        <tr>
                            <td>@index</td>
                            <td class="font-weight-semibold text-dark">@item.MedicineName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-right">@item.UnitPrice.ToString("N2") EGP</td>
                            <td class="text-right text-danger">- @item.Discount.ToString("N2") EGP</td>
                            <td class="text-right font-weight-bold">@item.Total.ToString("N2") EGP</td>
                            <td class="text-center d-print-none">@item.ReturnedQuantity</td>
                            <td class="text-center d-print-none">
                                @if (item.ReturnableQuantity > 0)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#returnModal-@item.Id">
                                        <i class="fas fa-rotate-left me-1"></i> Return
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">Fully returned</span>
                                }
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>

        @* Modals are rendered outside the table on purpose: nesting a Bootstrap modal
           inside a table (especially inside a .table-responsive wrapper, which sets
           overflow-x: auto) can clip it or stop it from displaying at all. *@
        @foreach (var item in Model.Items)
        {
            if (item.ReturnableQuantity > 0)
            {
                <div class="modal fade" id="returnModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="Sale" asp-action="ReturnItem" method="post">
                                <input type="hidden" name="SaleId" value="@Model.Id" />
                                <input type="hidden" name="SaleItemId" value="@item.Id" />

                                <div class="modal-header">
                                    <h5 class="modal-title">Return @item.MedicineName from customer</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted">
                                        Sold @item.Quantity, already returned @item.ReturnedQuantity.
                                    </p>
                                    <div class="form-group mb-3">
                                        <label>Quantity to return</label>
                                        <input type="number" name="Quantity" class="form-control"
                                               min="1" max="@item.ReturnableQuantity" value="1" required />
                                        <small class="text-muted">Up to @item.ReturnableQuantity unit(s) can still be returned.</small>
                                    </div>
                                    <div class="form-group">
                                        <label>Reason (optional)</label>
                                        <textarea name="Reason" class="form-control" rows="2" placeholder="e.g. Customer changed mind, wrong item..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Confirm Return</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Totals Column -->
        <div class="row justify-content-end">
            <div class="col-md-5">
                <table class="table table-bordered table-sm text-dark">
                    <tr>
                        <th class="text-left font-weight-semibold">Subtotal</th>
                        <td class="text-right">@subtotal.ToString("N2") EGP</td>
                    </tr>
                    @if (totalDiscount > 0)
                    {
                        <tr>
                            <th class="text-left font-weight-semibold text-danger">Total Discounts</th>
                            <td class="text-right text-danger">- @totalDiscount.ToString("N2") EGP</td>
                        </tr>
                    }
                    <tr class="bg-light">
                        <th class="text-left font-weight-bold text-lg">Grand Total</th>
                        <td class="text-right font-weight-bold text-lg text-primary-teal">@Model.TotalAmount.ToString("N2") EGP</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Invoice Footer Note -->
        <div class="text-center mt-5 text-muted small">
            <p>Thank you for choosing PharmaCare! Medicines cannot be returned without a receipt.</p>
        </div>

    </div>
</div>

<style>
    .bg-teal-light {
        background-color: var(--primary-light);
    }

    @@media print {
        body {
            background-color: white !important;
            color: black !important;
        }

        .main-sidebar, .main-header, .main-footer, .d-print-none {
            display: none !important;
        }

        .content-wrapper {
            margin-left: 0 !important;
            padding: 0 !important;
            background: white !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .invoice-container {
            border: none !important;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var modalElements = document.querySelectorAll('.modal');
            modalElements.forEach(function(modalEl) {
                try {
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    if (!modal) {
                        new bootstrap.Modal(modalEl);
                    }
                } catch (e) {
                    console.warn('Modal initialization error:', e);
                }
            });
        });
    </script>
}