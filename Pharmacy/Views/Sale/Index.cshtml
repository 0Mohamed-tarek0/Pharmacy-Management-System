@model IEnumerable<PharmacyBL.DTOs.Sales.SaleDto>

@{
    ViewData["Title"] = "Sales";
}

<div class="page-header">
    <div class="page-title">
        <div class="page-icon">
            <i class="fas fa-cash-register"></i>
        </div>
        <div>
            <h1>Sales Invoices</h1>
            <p class="page-subtitle">Track, view, and print sales invoices and monitor transaction history.</p>
        </div>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> New POS Sale
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list text-primary-teal"></i>
            All Sales Invoices
        </h3>
        <span class="badge badge-soft-primary">@Model.Count() total</span>
    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-cash-register"></i>
                </div>
                <h5>No sales yet</h5>
                <p>Start recording transactions by creating your first sale invoice.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> New POS Sale
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Cashier</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total Amount</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">
                                            <i class="fas fa-file-invoice-dollar" style="font-size:14px;"></i>
                                        </div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-primary-teal">@item.InvoiceNumber</a>
                                    </div>
                                </td>
                                <td>@item.CashierName</td>
                                <td class="text-muted">@item.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge bg-success">@item.Status</span>
                                </td>
                                <td class="fw-bold text-dark">@item.TotalAmount.ToString("N2") EGP</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm btn-icon"
                                       title="View Details/Receipt">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>
